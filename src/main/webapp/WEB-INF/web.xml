    <servlet-mapping>
        <servlet-name>StudentControllerServlet</servlet-name>
        <url-pattern>/StudentControllerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LecturerControllerServlet</servlet-name>
        <url-pattern>/LecturerControllerServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TechnicianDashboardServlet</servlet-name>
        <url-pattern>/technician/dashboard</url-pattern> 
    </servlet-mapping>
