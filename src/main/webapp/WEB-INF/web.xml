    </servlet>
    <servlet-mapping>
        <servlet-name>LecturerManagementServlet</servlet-name>
        <url-pattern>/LecturerManagementServlet</url-pattern>
    </servlet-mapping>
    <!--  SECURE WEB-INF VIEW MAPPINGS                           -->
    <!-- Admin Views -->
    <servlet>
        <servlet-name>AdminDashboardView</servlet-name>
        <jsp-file>/WEB-INF/admin/adminDashboard.jsp</jsp-file>
