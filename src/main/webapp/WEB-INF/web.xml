    <!--  BACKEND CONTROLLER SERVLETS                         -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.mycompany.mlms_system.controller.LoginServlet</servlet-class>
    </servlet>
